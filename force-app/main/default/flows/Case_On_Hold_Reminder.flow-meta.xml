    <formulas>
        <description>Used in message to customer to tell them how many weeks until closure of Case.</description>
        <name>forT_WeeksUntilClose</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.On_Hold_Reminder_Sent__c},
null, &apos;within 3 weeks&apos;,
&apos;1&apos;, &apos;within 2 weeks&apos;,
&apos;2&apos;, &apos;within 1 week&apos;,
&apos;by &apos; &amp; TEXT({!$Record.On_Hold_Date__c} + 28))</expression>
    </formulas>
