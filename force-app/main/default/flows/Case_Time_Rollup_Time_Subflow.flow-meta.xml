    <description>rollup time for the case and the timecard
W-002557: added Case Subject to Description of Work on two assignments using formulas.</description>
    <environments>Default</environments>
    <formulas>
        <description>Trim to 255 characters</description>
        <name>fDateDescription</name>
        <dataType>String</dataType>
        <expression>left({!varDateDescription}, 255)</expression>
    </formulas>
    <formulas>
        <name>forT_AssignCaseNumber</name>
        <dataType>String</dataType>
        <expression>&quot;Case #&apos;s: &quot; + {!Loop_Date_Case_Time.Case__r.CaseNumber} + &apos;: &apos; + Left({!Loop_Date_Case_Time.Case__r.Subject}, 10)</expression>
    </formulas>
    <formulas>
        <name>forT_AssignComma</name>
        <dataType>String</dataType>
        <expression>&apos;, &apos; + {!Loop_Date_Case_Time.Case__r.CaseNumber} + &apos;: &apos; + LEFT({!Loop_Date_Case_Time.Case__r.Subject},10)</expression>
    </formulas>
    <formulas>
        <name>fWaitOneMinute</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime}+0.0007</expression>
    </formulas>
