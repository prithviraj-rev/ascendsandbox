    <decisions>
        <name>Employee_Referral_via_Opportunity</name>
        <label>Employee Referral via Opportunity</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Closed_Won_Lost</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Opportunity_Record_var.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Opportunity_Record_var.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Employee_Referral_Close_Lost_Won</targetReference>
            </connector>
            <label>Closed Won/Lost</label>
        </rules>
        <rules>
            <name>Referral_Submitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Opportunity_Record_var.Referred_By__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Opportunity_Record_var.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Referral - Employee</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Employee_Referral_Submission</targetReference>
            </connector>
            <label>Referral Submitted</label>
        </rules>
    </decisions>
