    <decisions>
        <description>8/1/25 - Case#00016258 - adding this decision to cut down on when this process runs. Only needs to run when Est Hours, Client Rate, or Project on Assignment changes.</description>
        <name>Need_to_Update_Project_Hours</name>
        <label>Need to Update Project Hours?</label>
        <locationX>567</locationX>
        <locationY>1523</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Project_Hours</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Number_Of_Hours__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Client_Rate__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Projects__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fNewAssignment</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_all_Project_Assignments</targetReference>
            </connector>
            <label>Update Project Hours</label>
        </rules>
