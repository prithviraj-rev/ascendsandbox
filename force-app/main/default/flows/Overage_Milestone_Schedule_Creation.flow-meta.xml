    <formulas>
        <name>fx_CurrentBMName</name>
        <dataType>String</dataType>
        <expression>{!Loop_PLIs.Project__r.Name} 
&amp; &quot; - &quot; 
&amp; CASE(MONTH({!$Flow.CurrentDate}), 1, &quot;Q4&quot;, 4, &quot;Q1&quot;, 7, &quot;Q2&quot;, 10, &quot;Q3&quot;, &quot;QX&quot;)
&amp; &quot; &quot;
&amp; IF(MONTH(TODAY()) = 1, TEXT(YEAR({!$Flow.CurrentDate}) - 1), TEXT(YEAR({!$Flow.CurrentDate})))
&amp; &quot; Quarterly True Up&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_PLIDate</name>
        <dataType>Date</dataType>
        <expression>IF(MONTH(TODAY()) = 1,
			DATE(YEAR(TODAY()) - 1, 12, 1),
				DATE(YEAR(TODAY()),MONTH(TODAY()) - 1,1))</expression>
    </formulas>
    <formulas>
        <name>fx_RunDates</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	OR(MONTH(TODAY()) = 1,
	       MONTH(TODAY()) = 4,
		MONTH(TODAY()) = 7,
		MONTH(TODAY()) = 10),
	DAY(TODAY()) = 6)</expression>
    </formulas>
