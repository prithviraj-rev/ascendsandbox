        <name>fCaseRecordType</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!Get_Customer_Info.CommunityAccess__c}, &apos;App&apos;), &apos;0123b000000Utg0AAC&apos;, &apos;0123b000000UtfvAAC&apos;)</expression>
    </formulas>
    <formulas>
        <description>Merges value form 2 paths</description>
        <name>fDetailedDescriptionCombined</name>
        <dataType>String</dataType>
