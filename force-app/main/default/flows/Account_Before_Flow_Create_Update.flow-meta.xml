                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Neutral</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Health_Cybersecurity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Neutral</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Health_Data__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
