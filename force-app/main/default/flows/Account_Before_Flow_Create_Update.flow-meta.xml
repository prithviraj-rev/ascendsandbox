    <description>05/23: update to copy Shipping Address from Billing Address upon record creation [Case #00015672]
W-002570 - Added population of Invoice Date Change DT.
3/11/26: Update to Set Einstein Summary Last Generated to Today&apos;s date when the Account Summary field is updated.
3/23/26 - 00018208 - Added Population of Active Client when Invoice Date is changed.</description>
    <environments>Default</environments>
    <formulas>
        <name>fIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>fLastChanged</name>
        <dataType>Date</dataType>
        <expression>IF(MONTH(TODAY()) = 12, date( YEAR(ADDMONTHS(TODAY(), 1)), MONTH(ADDMONTHS(TODAY(), 1)) , 5), date( YEAR(TODAY()), MONTH(ADDMONTHS(TODAY(), 1)) , 5))</expression>
    </formulas>
    <formulas>
        <name>forD_LastYearToday</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()) - 1, MONTH(TODAY()), DAY(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>fxPlusOneWeek</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 7</expression>
    </formulas>
    <interviewLabel>Account: Before Flow Create Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account: Before Flow Create Update</label>
    <processMetadataValues>
