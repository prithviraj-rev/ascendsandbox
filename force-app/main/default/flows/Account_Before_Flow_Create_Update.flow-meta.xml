            <connector>
                <targetReference>Set_Risk_Status</targetReference>
            </connector>
            <label>Health is Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Risk_Changed</name>
        <label>Is Risk Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Risk Not Changed</defaultConnectorLabel>
        <rules>
            <name>Risk_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Risk_Status__c</leftValueReference>
