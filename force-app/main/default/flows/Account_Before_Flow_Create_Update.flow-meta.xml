            </conditions>
            <conditions>
                <leftValueReference>$Record.Health_Other__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Neutral</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Health_Project_Delivery__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Neutral</stringValue>
