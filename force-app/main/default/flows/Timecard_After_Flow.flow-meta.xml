    <recordUpdates>
        <description>Update values when timecard is created or updated</description>
        <name>Update_PLI_Record</name>
        <label>Update PLI Record</label>
        <locationX>94</locationX>
        <locationY>923</locationY>
        <connector>
            <targetReference>Created_or_Hours_Updated</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Project_Line_Item__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>MaxRate__c</field>
            <value>
                <elementReference>fMaxRate</elementReference>
            </value>
        </inputAssignments>
        <object>Project_Line_Item__c</object>
    </recordUpdates>
