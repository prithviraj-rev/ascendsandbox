<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_contract_End_date_is_not_Last_of_the_Month</name>
        <label>Check if contract End date is not Last of the Month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_End_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No It&apos;s not</defaultConnectorLabel>
        <rules>
            <name>It_is_last_of_the_month</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formIsContractEndDateLastOftheMonth</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>It is last of the month</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Start_Date_End_Date_Term_is_changed</name>
        <label>Check if Start Date, End Date, Term is changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Start_date_or_Term_got_changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StartDate</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ContractTerm</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Check_if_contract_End_date_is_not_Last_of_the_Month</targetReference>
            </connector>
            <label>Start date or Term got changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_new_Contract</name>
        <label>Is new Contract?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_if_Start_Date_End_Date_Term_is_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Update</defaultConnectorLabel>
        <rules>
            <name>Is_Record_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_contract_End_date_is_not_Last_of_the_Month</targetReference>
            </connector>
            <label>Is Record New</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formCalculatedEndDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.StartDate}, {!$Record.ContractTerm} + 1) - 
DAY(ADDMONTHS({!$Record.StartDate}, {!$Record.ContractTerm} + 1))</expression>
    </formulas>
    <formulas>
        <name>formIsContractEndDateLastOftheMonth</name>
        <dataType>Boolean</dataType>
        <expression>DAY({!$Record.EndDate}) = 
DAY(ADDMONTHS({!$Record.EndDate}, 1) - 1)</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Update End Date to the last day of the month {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update End Date to the last day of the month</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_End_Date</name>
        <label>Update End Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>EndDate</field>
            <value>
                <elementReference>formCalculatedEndDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_new_Contract</targetReference>
        </connector>
        <object>Contract</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
