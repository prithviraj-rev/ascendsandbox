    <decisions>
        <description>Determines whether the flow should create a new Feedback record name or update the existing name based on record changes and record type.</description>
        <name>Need_To_Create_Update_Records</name>
        <label>DEC Need To Create/Update Records?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_NTURN</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Resource_Reviewed</targetReference>
            </connector>
            <label>Create New Feedback</label>
        </rules>
        <rules>
            <name>Key_Fields_Changed</name>
            <conditionLogic>1 OR 2 OR 3 OR 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Resource_Reviewed__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Project__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assignment__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Submitter__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Resource_Reviewed</targetReference>
            </connector>
            <label>Update (Key Fields Changed)</label>
        </rules>
        <rules>
            <name>Escalation_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Feedback__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Feedback_to_Closed</targetReference>
            </connector>
            <label>Escalation Complete</label>
        </rules>
    </decisions>
    <description>After-save Flow for Feedback management. Updates Feedback Name, Assignment, and Project Role. If a Feedback record is escalated, launches the Escalation Feedback subflow to create the related Escalation record. If Status = Submitted, assigns the record to the Feedback Queue. When an Escalation is marked Complete, updates the original Feedback record from Escalated to Complete. Also launches a subflow to create and maintain Feedback Share records for the submitter. If the submitter changes, the existing share is deleted and recreated to maintain access.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns the User Id stored on the current Submitter Contact’s Resource User field. Used as the Internal Feedback sharing recipient.</description>
        <name>frmCurrentSubmitterResourceUserId</name>
        <dataType>String</dataType>
        <expression>{!$Record.Submitter__r.Resource_User_Record__c}</expression>
    </formulas>
    <formulas>
        <description>Determines whether the user derived from the current Submitter Contact is different from the user derived from the prior Submitter Contact.</description>
        <name>frmDidSubmitterResourceUserChange</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record__Prior.Id})) &amp;&amp;
{!frmCurrentSubmitterResourceUserId} &lt;&gt; {!frmPriorSubmitterResourceUserId}</expression>
    </formulas>
    <formulas>
        <description>Builds the Feedback record name using the Resource Reviewed and optional Project values. If a Project is present, the format is Resource Reviewed - Project Name - Month YYYY. If no Project is provided, the format is Resource Reviewed - Month YYYY.</description>
        <name>frmFeedbackName</name>
        <dataType>String</dataType>
        <expression>IF(
    $Record.RecordType.DeveloperName = &quot;Escalation&quot;,

    /* ESCALATION FORMAT */
    LEFT(
        &quot;Escalation - &quot; &amp;
        {!Get_Resource_Reviewed.Name} &amp;
        &quot; - &quot; &amp;
        {!MonthYYYY},
        80
    ),

    /* STANDARD FORMAT */
    IF(
        ISBLANK($Record.Project__c),

        /* No Project */
        LEFT(
            {!Get_Resource_Reviewed.Name} &amp;
            &quot; - &quot; &amp;
            {!MonthYYYY},
            80
        ),

        /* With Project (truncate project name dynamically) */
        LEFT(
            {!Get_Resource_Reviewed.Name} &amp;
            &quot; - &quot; &amp;
            LEFT(
                {!Get_Project.Name},
                80 -
                LEN({!Get_Resource_Reviewed.Name}) -
                LEN(&quot; - &quot;) -
                LEN({!MonthYYYY})
            ) &amp;
            &quot; - &quot; &amp;
            {!MonthYYYY},
            80
        )
    )
)</expression>
    </formulas>
    <formulas>
        <description>Determines whether the current Feedback record is being created for the first time by checking whether there is a prior version of the record in the flow context.</description>
        <name>frmIsNewFeedbackRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!$Record__Prior.Id})</expression>
    </formulas>
    <formulas>
        <description>Returns the User Id stored on the prior Submitter Contact’s Resource User field. Used to find and remove the old Internal Feedback share when the submitter changes.</description>
        <name>frmPriorSubmitterResourceUserId</name>
        <dataType>String</dataType>
        <expression>{!$Record__Prior.Submitter__r.Resource_User_Record__c}</expression>
    </formulas>
    <formulas>
        <description>Returns the current month and year in text format (for example, “February 2026”) based on TODAY().</description>
        <name>MonthYYYY</name>
        <dataType>String</dataType>
        <expression>CASE(
  MONTH(TODAY()),
  1, &quot;January&quot;,
  2, &quot;February&quot;,
  3, &quot;March&quot;,
  4, &quot;April&quot;,
  5, &quot;May&quot;,
  6, &quot;June&quot;,
  7, &quot;July&quot;,
  8, &quot;August&quot;,
  9, &quot;September&quot;,
  10, &quot;October&quot;,
  11, &quot;November&quot;,
  &quot;December&quot;
) &amp; &quot; &quot; &amp; TEXT(YEAR(TODAY()))</expression>
    </formulas>
