                <elementReference>Send_Email</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <name>ProjectRecordType_Managed_Services</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Managed_Services</stringValue>
        </value>
    </constants>
    <decisions>
        <description>The percentage of &apos;Billable Hours Worked&apos; of &apos;Est Hours&apos;.</description>
        <name>Percentage_of_Est_Hours_Used</name>
        <label>Percentage of Est Hours Used</label>
        <locationX>182</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Greater_or_Equal_80</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BillableHoursWorkedPercentageOfEstHour</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.8</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Recipient_s_Email_Addresses</targetReference>
            </connector>
            <label>Greater or Equal 80%</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the Project Record Type is Managed_Services or not.</description>
        <name>Project_Record_Type</name>
        <label>Project Record Type</label>
        <locationX>380</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Managed_Services</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ProjectLineItem.Project__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ProjectLineItem.Project__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ProjectRecordType_Managed_Services</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Percentage_of_Est_Hours_Used</targetReference>
            </connector>
            <label>Managed Services</label>
        </rules>
    </decisions>
    <description>Send an email alert to SDMS when an MS Engagement uses 80% of their monthly Est Hours.</description>
    <environments>Default</environments>
    <formulas>
        <name>BillableHoursWorkedPercentageOfEstHour</name>
        <dataType>Number</dataType>
        <expression>{!ProjectLineItem.Billable_Hours_Worked__c}/{!ProjectLineItem.Est_Hours__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>OrgBaseUrl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_260}))</expression>
    </formulas>
    <interviewLabel>Project Line Item: MS Project Monthly Budget Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Project Line Item: MS Project Monthly Budget Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
