        <locationX>50</locationX>
        <locationY>398</locationY>
        <assignmentItems>
            <assignToReference>SendToEmailAddresses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ProjectLineItem.Project__r.Project_Lead__r.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Email</targetReference>
        </connector>
