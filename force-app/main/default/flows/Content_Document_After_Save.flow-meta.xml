<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Docx_or_PDF_File</name>
        <label>Docx or PDF File</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Docx</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forT_TitleIncludesDocx</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>.docx</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Docx_Extension_From_Title</targetReference>
            </connector>
            <label>Docx</label>
        </rules>
        <rules>
            <name>PDF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forT_TitleIncludesPDF</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>.pdf</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_PDF_Extension_From_Title</targetReference>
            </connector>
            <label>PDF</label>
        </rules>
    </decisions>
    <description>2/16/26 - SharePoint Integration - Created to remove &quot;.doxc&quot; and &quot;.pdf&quot; from Content Document Title that is automatically added by Conga. Required to be after flow as before flow was causing errors in Conga generation.</description>
    <environments>Default</environments>
    <formulas>
        <name>forT_TitleIncludesDocx</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.Title},5)</expression>
    </formulas>
    <formulas>
        <name>forT_TitleIncludesPDF</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.Title},4)</expression>
    </formulas>
    <formulas>
        <name>forT_TitleWithoutDocx</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Title},(LEN({!$Record.Title})-5))</expression>
    </formulas>
    <formulas>
        <name>forT_TitleWithoutPDF</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Title},(LEN({!$Record.Title})-4))</expression>
    </formulas>
    <interviewLabel>Content Document: After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Content Document: After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Remove_Docx_Extension_From_Title</name>
        <label>Remove Docx Extension From Title</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>forT_TitleWithoutDocx</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Remove_PDF_Extension_From_Title</name>
        <label>Remove PDF Extension From Title</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>forT_TitleWithoutPDF</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Docx_or_PDF_File</targetReference>
        </connector>
        <object>ContentDocument</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
