            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Timecard_Value</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Created_or_Updated</name>
        <label>Created or Updated</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Date_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Updated</defaultConnectorLabel>
        <rules>
            <name>Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Created</label>
        </rules>
    </decisions>
    <decisions>
        <description>Case Time date changed or Billable value changed</description>
        <name>Date_Changed</name>
        <label>Date or Billable Changed</label>
        <locationX>473</locationX>
        <locationY>455</locationY>
        <defaultConnector>
            <targetReference>Rollup_Case_Time</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Billable__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Billable__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Timecard__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Timecard__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Different_Timecard</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Timecard_Exists</name>
        <label>Timecard Exists</label>
        <locationX>275</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Get_PLI_for_Changed_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesTimecardExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Different_Timecard.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Var</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fFirstofSelectedMonth</name>
        <dataType>Date</dataType>
        <expression>date(Year({!$Record.Date__c}), Month({!$Record.Date__c}), 1)</expression>
    </formulas>
    <formulas>
        <name>fLastDayofSelectedMonth</name>
        <dataType>Date</dataType>
        <expression>addmonths( Date(Year({!$Record.Date__c}), Month({!$Record.Date__c}), 1), 1)</expression>
    </formulas>
    <formulas>
        <description>Converts boolean to text</description>
        <name>fType</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Billable__c}, &apos;Billable&apos;, &apos;Non-Billable&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
