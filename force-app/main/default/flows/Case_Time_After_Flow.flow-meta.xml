        </inputAssignments>
        <inputAssignments>
            <field>Type__c</field>
            <value>
                <elementReference>fType</elementReference>
            </value>
        </inputAssignments>
        <object>SFDC_Timecard__c</object>
    </recordCreates>
    <recordLookups>
        <description>Since date was changed we need to get a different timecard</description>
        <name>Get_Different_Timecard</name>
        <label>Get Different Timecard</label>
        <locationX>275</locationX>
        <locationY>575</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Timecard_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Assignment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Assignment__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Project_Line_Item__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Timecard__r.Project_Line_Item__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>fType</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SFDC_Timecard__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_PLI_for_Changed_Date</name>
        <label>Get PLI for Changed Date</label>
        <locationX>407</locationX>
        <locationY>815</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Timecard</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Timecard__r.Project_Line_Item__r.Project__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fFirstofSelectedMonth</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>fLastDayofSelectedMonth</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Project_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
