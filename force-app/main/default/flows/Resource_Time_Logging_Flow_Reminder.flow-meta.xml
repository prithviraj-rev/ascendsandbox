    <decisions>
        <description>Skip reminders on Sat/Sun.</description>
        <name>Is_Weekend</name>
        <label>Is Weekend?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Assignments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Weekday</defaultConnectorLabel>
        <rules>
            <name>Weekend</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_IsWeekend</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Weekend</label>
        </rules>
    </decisions>
    <decisions>
        <description>Compares logged vs projected hours. If projected &lt; 8 hrs and logged &lt; projected, notify. If project &gt;= 8 hrs and logged &lt; 8, notify.</description>
        <name>Under_Logged</name>
        <label>Under-Logged?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Under</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>nLogged</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>nProjectd</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Employment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>1099</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>nLogged</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>8.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Employment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>W2</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Under_Logged_Email</targetReference>
            </connector>
            <label>Yes - Under</label>
        </rules>
    </decisions>
    <description>Sends reminder emails at 7pm CST if a Resource has not logged enough time compared to their projected hours. Supports both W2 employees and 1099 contractors. Calculates projected vs logged hours daily and notifies both the resource and their manager if under-logged.

6/11/26 - added &quot;exclude from timesheet reminders equals false&quot; to the entry criteria.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_IsWeekend</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  WEEKDAY(DATEVALUE(NOW())) = 1, /* Sunday */
  WEEKDAY(DATEVALUE(NOW())) = 7  /* Saturday */
)</expression>
    </formulas>
    <formulas>
        <name>fCCEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Employment_Type__c},&apos;W2&apos;),
&apos;&apos;,
IF({!$Record.Id}&lt;&gt;{!$Record.Account.Primary_Contact__r.Id},
{!$Record.Account.Primary_Contact__r.Personal_Email__c},&apos;&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>fContactId15</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Id},15)</expression>
    </formulas>
    <formulas>
        <name>fRecipientEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Employment_Type__c},&apos;W2&apos;),
{!$Record.Email},
{!$Record.Personal_Email__c})</expression>
    </formulas>
