            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>&lt;div style=&quot;font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#181818; line-height:1.5;&quot;&gt;
  &lt;p style=&quot;margin:0 0 16px 0;&quot;&gt;
    &lt;img src=&quot;{!varEmailHeaderImageUrl}&quot; alt=&quot;Email Header&quot; style=&quot;display:block; max-width:100%; height:auto; border:0;&quot;&gt;
  &lt;/p&gt;
