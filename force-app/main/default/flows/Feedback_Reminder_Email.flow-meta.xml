    <decisions>
        <description>Routes the current submitter into the correct email recipient collection. Internal recipients are W2 employees and 1099 contractors with internal org access (Portal Enabled = false). Portal recipients are 1099 contractors with community access (Portal enabled = true).</description>
        <name>DEC_Submitter_is_Internal_or_Portal_Recipient</name>
        <label>DEC Submitter is Internal or Portal Recipient?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Portal_User_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Portal</defaultConnectorLabel>
        <rules>
            <name>Internal</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Submitter__r.Employment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>W2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Submitter__r.Employment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>1099</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Submitter__r.Resource_User_Record__r.IsPortalEnabled</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Internal_Submitter_Values</targetReference>
            </connector>
            <label>Internal</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the Feedback record is both unedited and at least 7 days old, meaning it should be deleted.</description>
        <name>DEC_Unedited_for_7_days</name>
        <label>DEC Unedited for 7+ days?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DEC_Submitter_is_Internal_or_Portal_Recipient</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Keep</defaultConnectorLabel>
        <rules>
            <name>Yes_Delete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.CreatedDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>CutoffDateTime7Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal_Feedback</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Project Retro</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ASSIGN_Feedback_to_Delete_Collection</targetReference>
            </connector>
            <label>Yes - Delete</label>
        </rules>
    </decisions>
    <description>Runs daily to send a consolidated reminder to submitters who have at least one qualifying open Feedback record. Recipients receive either an internal or portal list view link and are deduped so they only receive one email regardless of number of open Feedback records.</description>
    <environments>Default</environments>
    <formulas>
        <description>Used to find Feedback records created at least 3 days ago.</description>
        <name>CutoffDateTime3Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 3</expression>
    </formulas>
    <formulas>
        <description>DateTime threshold used to identify records created 7+ days ago.</description>
        <name>CutoffDateTime7Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <formulas>
        <description>Returns the internal Salesforce list view link for “My Pending Feedback” from Custom Label.</description>
        <name>InternalFeedbackListViewURL</name>
        <dataType>String</dataType>
        <expression>{!$Label.Feedback_ListView_Internal_Prod_URL}</expression>
    </formulas>
    <formulas>
        <description>Returns the contractor portal list view link for “My Pending Feedback” from Custom Label.</description>
        <name>PortalFeedbackListViewURL</name>
        <dataType>String</dataType>
        <expression>{!$Label.Feedback_ListView_Community_URL}</expression>
    </formulas>
    <interviewLabel>Feedback Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Feedback: Reminder Email</label>
    <loops>
        <description>Iterates through the collection of internal recipients who have at least one qualifying unedited Feedback record. For each recipient, the flow sends a reminder email containing the link to their pending feedback.</description>
        <name>LOOP_Internal_Recipient_Emails</name>
        <label>LOOP Internal Recipient Emails</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>colInternalContacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Send_Feedback_Email_to_Internal</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>DEC_Is_Portal_Recipient_populated</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterates through the collection of portal recipients who have at least one qualifying unedited Feedback record. For each recipient, the flow sends a reminder email containing the link to their pending feedback.</description>
        <name>LOOP_Portal_Recipient_Emails</name>
        <label>LOOP Portal Recipient Emails</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>colPortalContacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Send_Feedback_Email_to_Portal</targetReference>
        </nextValueConnector>
    </loops>
    <loops>
        <description>Iterates through qualifying Feedback records to build unique internal and portal email recipient lists without sending one email per Feedback record.</description>
        <name>LOOP_through_Qualifying_Feedback</name>
        <label>LOOP through Qualifying Feedback</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GET_Qualifying_Feedback</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>DEC_Has_Feedback_been_Edited</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>DEC_Is_Delete_Collection_Populated</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <description>Bulk deletes Feedback records that are unedited and 7+ days old.</description>
        <name>DELETE_Unedited_Feedback_7_Days</name>
        <label>DELETE Unedited Feedback 7+ Days</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DEC_Is_Internal_Recipient_populated</targetReference>
        </connector>
        <inputReference>colFeedbackToDelete</inputReference>
    </recordDeletes>
    <recordLookups>
        <description>Retrieves Feedback records that are still open, created at least 3 days ago, and unchanged since creation. These records are used to determine which submitters should receive a consolidated reminder email.</description>
        <name>GET_Qualifying_Feedback</name>
        <label>GET Qualifying Feedback</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LOOP_through_Qualifying_Feedback</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>CutoffDateTime3Days</elementReference>
            </value>
        </filters>
        <filters>
            <field>Submitter__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Feedback__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GET_Qualifying_Feedback</targetReference>
        </connector>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-04-03</startDate>
            <startTime>18:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
