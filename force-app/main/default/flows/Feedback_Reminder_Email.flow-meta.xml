    <decisions>
        <description>Checks whether the current submitter email is already in the internal recipient collection to prevent duplicate recipients when a submitter has multiple qualifying Feedback records.</description>
        <name>DEC_Already_Exists_in_Internal_Recipient_List</name>
        <label>DEC Already Exists in Internal Recipient List?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Submitter_to_Internal_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Does Not Exist</defaultConnectorLabel>
        <rules>
            <name>Exists_Internal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>txtInternalEmailList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>recInternalUser.Email</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LOOP_through_Qualifying_Feedback</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the current submitter email is already in the portal recipient collection to prevent duplicates when a submitter has multiple qualifying Feedback records.</description>
        <name>DEC_Already_Exists_in_Portal_Recipient_List</name>
        <label>DEC Already Exists in Portal Recipient List?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Submitter_to_Portal_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Does Not Exist</defaultConnectorLabel>
        <rules>
            <name>Exists_External</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>txtPortalEmailList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>recPortalUser.Email</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LOOP_through_Qualifying_Feedback</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the Feedback record has been modified since creation. Only records that have not been edited are processed for reminder emails.</description>
        <name>DEC_Has_Feedback_been_Edited</name>
        <label>DEC Has Feedback been Edited?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DEC_Unedited_for_7_days</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unedited</defaultConnectorLabel>
        <rules>
            <name>Edited</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6 OR 7)</conditionLogic>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal Feedback</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Project Retro</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Verbal_Communication__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Technical_Skills__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Time_Management__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Comments__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LOOP_through_Qualifying_Feedback.Written_Communication__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LOOP_through_Qualifying_Feedback</targetReference>
            </connector>
            <label>Edited</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether any records were flagged for deletion.</description>
        <name>DEC_Is_Delete_Collection_Populated</name>
        <label>DEC Is Delete Collection Populated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DEC_Is_Internal_Recipient_populated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesRecordstodelete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colFeedbackToDelete</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DELETE_Unedited_Feedback_7_Days</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
