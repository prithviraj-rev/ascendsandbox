    <decisions>
        <name>Identify_SLA_Window</name>
        <label>Identify SLA Window</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_SLA_Candidate_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ignore</defaultConnectorLabel>
        <rules>
            <name>HighPriorityWindow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_SLA_Candidate_Cases.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_SLA_Candidate_Cases.Case_Age__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Append_High_Row</targetReference>
            </connector>
            <label>HighPriorityWindow</label>
        </rules>
        <rules>
            <name>MediumPriorityWindow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_SLA_Candidate_Cases.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_SLA_Candidate_Cases.Case_Age__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>23.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Append_Medium_Row</targetReference>
            </connector>
            <label>MediumPriorityWindow</label>
        </rules>
    </decisions>
