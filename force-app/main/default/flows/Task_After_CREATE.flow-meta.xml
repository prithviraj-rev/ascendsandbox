    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>con_SOATeamGroupId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>00GVF000007QTOw</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Checks to see if this is a NON DTS opportunity. If so, goes down the path to send the message to the SOA team.</description>
        <name>Check_LOB_of_Opportunity</name>
        <label>Check LOB of Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Notify_SOA_Team_of_Contract_Generation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non DTS Opportunity</defaultConnectorLabel>
        <rules>
            <name>DTS_Opportunity</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Record.Service_Offering_Rollup__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Salesforce</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Record.Service_Offering_Rollup__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>HubSpot</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Record.Service_Offering_Rollup__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Zingly</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Churn</stringValue>
                </rightValue>
            </conditions>
            <label>DTS Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Found_File</name>
        <label>Found File</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DeleteTask</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetCDL</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Docx_or_PDF_from_Title</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if the Task is for an Opportunity or another object.</description>
        <name>Is_Task_for_Opportunity</name>
        <label>Is Task for Opportunity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Task_For_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhatId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Record</targetReference>
            </connector>
            <label>Task For Opportunity</label>
        </rules>
    </decisions>
    <description>This flow runs for all Conga Generated Documents. It uploads the file to 24Files and process other logic that should be run when Files are generated.

Updates: 
00018199 - 5/5/2026 - Added logic for communication to SOA Team.</description>
    <environments>Default</environments>
    <formulas>
        <name>forT_ContentDocumentTitle</name>
        <dataType>String</dataType>
        <expression>IF(
	RIGHT({!GetCDL.ContentDocument.Title}, 5) = &apos;.docx&apos;, 
	LEFT({!GetCDL.ContentDocument.Title},(LEN({!GetCDL.ContentDocument.Title})-5)),
	IF(
		RIGHT({!GetCDL.ContentDocument.Title}, 4) = &apos;.pdf&apos;, 
		LEFT({!GetCDL.ContentDocument.Title},(LEN({!GetCDL.ContentDocument.Title})-4)),
		{!GetCDL.ContentDocument.Title}))</expression>
    </formulas>
    <interviewLabel>Task: After CREATE {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task: Conga Generation Logic</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>DeleteTask</name>
        <label>DeleteTask</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordDeletes>
    <recordLookups>
        <description>Get Opportunity related to Task.</description>
        <name>Get_Opportunity_Record</name>
        <label>Get Opportunity Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_LOB_of_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetCDL</name>
        <label>GetCDL</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Found_File</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <sortField>SystemModstamp</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Remove_Docx_or_PDF_from_Title</name>
        <label>Remove Docx or PDF from Title</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Add_File_to_Upload</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetCDL.ContentDocumentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>forT_ContentDocumentTitle</elementReference>
            </value>
        </inputAssignments>
        <object>ContentDocument</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Task_for_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>File Created for Sharepoint</stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>GetCDL</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>txtTemp_MessageToSOATeam</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;@{!con_SOATeamGroupId} A SOW has been generated for {!Get_Opportunity_Record.Name}. Please review and mark the Opportunity Approved so the Owner can use Sign Doc.&lt;/p&gt;</text>
    </textTemplates>
</Flow>
