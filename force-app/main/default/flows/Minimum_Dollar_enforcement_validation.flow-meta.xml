<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Copy_2_of_Monitoring_Fee_Less_than_350</name>
        <label>Managed security  Fee Less than 250</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Combined monthly total of Managed Security Lines cannot be less than $250.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Monitoring_Fee_Less_than_350</name>
        <label>Monitoring Fee Less than 350</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Combined monthly total of Monitoring Lines cannot be less than $350.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_Monitoring_Fee_and_Managed_Fees_are_less_than_minimum</name>
        <label>Check if Monitoring Fee and Managed Fees are less than minimum</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_It_is</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formMonitoringMonthlyFee</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>350.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Monitoring_Fee__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Monitoring_Fee_Less_than_350</targetReference>
            </connector>
            <label>Yes It is</label>
        </rules>
        <rules>
            <name>Yes_Managed_Security_less_Than_250</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formManagedSecFee</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>250.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Managed_Security_Awareness_Program_Fee__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Monitoring_Fee_Less_than_350</targetReference>
            </connector>
            <label>Yes Managed Security less Than 250</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formManagedSecFee</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Managed_Security_Awareness_Program_Fee__c}/{!$Record.Contract_Term_Months__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formMonitoringMonthlyFee</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Monitoring_Fee__c}/{!$Record.Contract_Term_Months__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Minimum Dollar enforcement validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Minimum Dollar enforcement validation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Monitoring_Fee_and_Managed_Fees_are_less_than_minimum</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Monitoring_Fee__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Managed_Security_Awareness_Program_Fee__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
