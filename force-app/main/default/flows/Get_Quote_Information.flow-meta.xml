            <label>CFO EVP Approval Needed</label>
        </rules>
        <rules>
            <name>VP_Approval_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MaxMarginShortfall</leftValueReference>
                <operator>GreaterThan</operator>
