    <decisions>
        <name>Check_Quote_margins_are_below_threshold</name>
        <label>Check Quote margins are below threshold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_all_Quote_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Margins</name>
            <conditionLogic>(1 AND 7) OR (2 AND 8) OR (3 AND 9) OR (4 AND 10) OR (5 AND 11) OR (6 AND 12)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Service_Desk_Margin__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>45.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Infrastructure_Margin__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>55.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Cybersecurity_Margin__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Private_Cloud_Margin__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>65.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.VOIP_Margin__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>35.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Onboarding_Margin__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>45.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Service_Desk_Margin__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Infrastructure_Margin__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Cybersecurity_Margin__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Private_Cloud_Margin__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.VOIP_Margin__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Onboarding_Margin__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Needed</targetReference>
            </connector>
            <label>Check Margins</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_QuoteLine_Item_Discount</name>
        <label>Check Quote Line Item Discount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_QuoteLineItems</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Term_Defined_and_Discount_Greater_than_5</name>
            <conditionLogic>and</conditionLogic>
