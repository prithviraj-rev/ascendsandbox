                <leftValueReference>Loop_QuoteLineItems.SellingModelType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TermDefined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LineLevelDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_QuoteLineItems.Product2.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Managed Services</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Needed_for_Term_Defined</targetReference>
            </connector>
            <label>Term Defined and Discount Greater than 5</label>
        </rules>
        <rules>
            <name>One_Time_and_Discount_Greater_than_10_and_Less_than_50</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LineLevelDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LineLevelDiscount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_QuoteLineItems.SellingModelType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OneTime</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_QuoteLineItems.Product2.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Managed Services</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_QuoteLineItems.Net_Unit_Price_After_System_Discounts__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Needed_for_One_Time</targetReference>
            </connector>
            <label>One Time and Discount Greater than 10 and Less than 50</label>
        </rules>
        <rules>
            <name>PS_Products_Discount_and_Margin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_QuoteLineItems.Product2.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Professional Services</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LineLevelDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_QuoteLineItems.Margin</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>45.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Needed_for_PS_Products</targetReference>
            </connector>
            <label>PS Products Discount and Margin</label>
        </rules>
    </decisions>
    <decisions>
        <name>Renewal_Margin_Shortfall</name>
        <label>Renewal Margin Shortfall</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CFO_EVP_Approval_Needed</name>
