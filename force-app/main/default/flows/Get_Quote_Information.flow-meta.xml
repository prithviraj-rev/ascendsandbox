    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fCybersecurityShortfall</name>
        <dataType>Number</dataType>
        <expression>IF(AND({!Get_Account.Cybersecurity_Margin__c} &gt; 0, {!Get_Quote.Cybersecurity_Margin__c} &gt; 0, {!Get_Account.Cybersecurity_Margin__c} &gt; {!Get_Quote.Cybersecurity_Margin__c}), {!Get_Account.Cybersecurity_Margin__c} - {!Get_Quote.Cybersecurity_Margin__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fInfrastructureShortfall</name>
        <dataType>Number</dataType>
        <expression>IF(AND({!Get_Account.Infrastructure_Margin__c} &gt; 0, {!Get_Quote.Infrastructure_Margin__c} &gt; 0, {!Get_Account.Infrastructure_Margin__c} &gt; {!Get_Quote.Infrastructure_Margin__c}), {!Get_Account.Infrastructure_Margin__c} - {!Get_Quote.Infrastructure_Margin__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fOnboardingShortfall</name>
        <dataType>Number</dataType>
        <expression>IF(AND({!Get_Account.Onboarding_Margin__c} &gt; 0, {!Get_Quote.Onboarding_Margin__c} &gt; 0, {!Get_Account.Onboarding_Margin__c} &gt; {!Get_Quote.Onboarding_Margin__c}), {!Get_Account.Onboarding_Margin__c} - {!Get_Quote.Onboarding_Margin__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fPrivateCloudShortfall</name>
        <dataType>Number</dataType>
        <expression>IF(AND({!Get_Account.Private_Cloud_Margin__c} &gt; 0, {!Get_Quote.Private_Cloud_Margin__c} &gt; 0, {!Get_Account.Private_Cloud_Margin__c} &gt; {!Get_Quote.Private_Cloud_Margin__c}), {!Get_Account.Private_Cloud_Margin__c} - {!Get_Quote.Private_Cloud_Margin__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fServiceDeskShortfall</name>
        <dataType>Number</dataType>
        <expression>IF(AND({!Get_Account.Service_Desk_Margin__c} &gt; 0, {!Get_Quote.Service_Desk_Margin__c} &gt; 0, {!Get_Account.Service_Desk_Margin__c} &gt; {!Get_Quote.Service_Desk_Margin__c}), {!Get_Account.Service_Desk_Margin__c} - {!Get_Quote.Service_Desk_Margin__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fVOIPShortfall</name>
        <dataType>Number</dataType>
        <expression>IF(AND({!Get_Account.VOIP_Margin__c} &gt; 0, {!Get_Quote.VOIP_Margin__c} &gt; 0, {!Get_Account.VOIP_Margin__c} &gt; {!Get_Quote.VOIP_Margin__c}), {!Get_Account.VOIP_Margin__c} - {!Get_Quote.VOIP_Margin__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>LineLevelDiscount</name>
        <dataType>Number</dataType>
        <expression>(({!Loop_QuoteLineItems.Net_Unit_Price_After_System_Discounts__c} - {!Loop_QuoteLineItems.NetUnitPrice}) / {!Loop_QuoteLineItems.Net_Unit_Price_After_System_Discounts__c}) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MaxMarginShortfall</name>
        <dataType>Number</dataType>
        <expression>MAX({!fServiceDeskShortfall}, {!fInfrastructureShortfall}, {!fCybersecurityShortfall}, {!fPrivateCloudShortfall}, {!fVOIPShortfall}, {!fOnboardingShortfall})</expression>
        <scale>2</scale>
    </formulas>
