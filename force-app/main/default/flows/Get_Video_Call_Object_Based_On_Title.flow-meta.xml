    <description>Using VidCall_RecMatch_Title_Classification__mdt and Videocall title, return the object and record that should be used</description>
    <environments>Default</environments>
    <formulas>
        <description>Extracts the Project keyword from the meeting title:
Marshall &amp; Sterling - FSC Weekly Status → FSC
Marshall &amp; Sterling - HubSpot Weekly Status → HubSpot</description>
        <name>f_ExtractProjKeyword</name>
        <dataType>String</dataType>
        <expression>LOWER(
  MID(
    {!MeetingTitle},
    FIND(&quot; - &quot;, {!MeetingTitle}) + 3,
    FIND(&quot; &quot;, {!MeetingTitle}, FIND(&quot; - &quot;, {!MeetingTitle}) + 3) - (FIND(&quot; - &quot;, {!MeetingTitle}) + 3)
  )
)</expression>
    </formulas>
    <formulas>
        <description>Get the Project name from the title of the meeting</description>
        <name>OppProjName</name>
        <dataType>String</dataType>
        <expression>
{!Get_Account_Name.Name} &amp; &quot; - &quot; &amp;
LOWER(
  MID(
    {!MeetingTitle},
    FIND(&quot; - &quot;, {!MeetingTitle}) + 1,
    FIND(&quot; - &quot;, {!MeetingTitle}, FIND(&quot; - &quot;, {!MeetingTitle}) + 1) - (FIND(&quot; - &quot;, {!MeetingTitle}) + 1)
  )
)</expression>
    </formulas>
