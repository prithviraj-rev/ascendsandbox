    <formulas>
        <name>BaseHours</name>
        <dataType>Number</dataType>
        <expression>{!Get_Project_Details.Monthly_Recurring_Hours__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Just for display on screen</description>
        <name>Carryover25PercentCalc</name>
        <dataType>Number</dataType>
        <expression>{!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}*{!Get_Project_Details.Carryover_Allowed__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This displays extra text to explain why carryover was not calculated</description>
        <name>CarryoverCanceledNote</name>
        <dataType>String</dataType>
        <expression>IF(({!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}-{!CurrentPLI.Billable_Hours_Worked__c})&gt;0 &amp;&amp; {!fRolloverHours}&lt;0 , &apos;**NOTE** Some or all of the potential carryover hours have been applied to compensating for a negative rollover balance&apos;, &apos; &apos;)</expression>
    </formulas>
    <formulas>
        <description>Calculate Rollover from current PLI</description>
        <name>CarryOverHours</name>
        <dataType>Number</dataType>
        <expression>IF({!Carryover25PercentCalc} &gt;{!MonRecHours_minus_HoursUsed}, {!MonRecHours_minus_HoursUsed}, {!Carryover25PercentCalc})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>EndofMonth</name>
        <dataType>Date</dataType>
        <expression>AddMonths(Date(Year({!Month}), Month({!Month}), 1), 1)</expression>
    </formulas>
    <formulas>
        <name>fBMInvoiceStatus</name>
        <dataType>String</dataType>
        <expression>Blankvalue(TEXT({!Get_Matching_BM.Invoice_Status__c}), &quot;All Time Entered&quot;)</expression>
    </formulas>
    <formulas>
        <name>FirstofCurrentMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(IF(ISBLANK({!CurrentPLI.Date__c}), TODAY(), ADDMONTHS({!CurrentPLI.Date__c}, 1))), MONTH(IF(ISBLANK({!CurrentPLI.Date__c}), TODAY(), ADDMONTHS({!CurrentPLI.Date__c}, 1))), 1)</expression>
    </formulas>
    <formulas>
        <name>fPLIServiceMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!CurrentPLI.Date__c}), MONTH({!CurrentPLI.Date__c}), 1)</expression>
    </formulas>
    <formulas>
        <name>fRolloverHours</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!CurrentPLI.Rollover_Hours__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MonRecHours_minus_HoursUsed</name>
        <dataType>Number</dataType>
        <expression>IF({!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}-{!CurrentPLI.Billable_Hours_Worked__c}&gt;0 &amp;&amp; NOT({!fRolloverHours}&lt;0), {!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}-{!CurrentPLI.Billable_Hours_Worked__c}, IF({!fRolloverHours}&lt;0 &amp;&amp; NOT(({!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}-{!CurrentPLI.Billable_Hours_Worked__c})&lt;ABS({!fRolloverHours})),{!fRolloverHours}+{!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}-{!CurrentPLI.Billable_Hours_Worked__c} ,0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NextMonthEstHours</name>
        <dataType>Number</dataType>
        <expression>{!CurrentPLI.Project__r.Monthly_Recurring_Hours__c}+{!CarryOverHours}+IF({!RolloverRemaining}&gt;0, {!RolloverRemaining}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ProjectLineName</name>
        <dataType>String</dataType>
        <expression>{!CurrentPLI.Project__r.Name} &amp; &quot; - &quot; &amp; CASE(MONTH(IF(ISBLANK({!CurrentPLI.Date__c}), TODAY(), ADDMONTHS({!CurrentPLI.Date__c}, 1))),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;, 
4, &quot;April&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;) &amp; &quot; &quot; &amp; TEXT(YEAR(IF(ISBLANK({!CurrentPLI.Date__c}), TODAY(), ADDMONTHS({!CurrentPLI.Date__c}, 1))))</expression>
    </formulas>
    <formulas>
        <name>RolloverAvailable</name>
        <dataType>Number</dataType>
        <expression>{!fRolloverHours}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RolloverRemaining</name>
        <dataType>Number</dataType>
        <expression>{!RolloverAvailable}+{!RolloverUsed}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RolloverUsed</name>
        <dataType>Number</dataType>
        <expression>IF({!CurrentPLI.Billable_Hours_Worked__c}&gt;{!Get_Project_Details.Monthly_Recurring_Hours__c}+{!CurrentPLI.CarryoverHours__c} || {!fRolloverHours}&lt;0, {!CurrentPLI.Billable_Hours_Worked__c}-{!Get_Project_Details.Monthly_Recurring_Hours__c}-{!CurrentPLI.CarryoverHours__c}+{!MonRecHours_minus_HoursUsed},  0)*-1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RolloverUsedText</name>
        <dataType>String</dataType>
        <expression>If({!RolloverUsed}&lt;1, &apos;Rollover Used&apos;, &apos;Potential Carryover used to reduce deficit&apos;)</expression>
    </formulas>
    <formulas>
        <name>StartofMonth</name>
        <dataType>Date</dataType>
        <expression>Date(Year({!Month}), Month({!Month}), 1)</expression>
    </formulas>
    <formulas>
        <name>SupportCoordinationSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Support Coordination - &quot; &amp; CASE(MONTH(IF(ISBLANK({!CurrentPLI.Date__c}), TODAY(), ADDMONTHS({!CurrentPLI.Date__c}, 1))),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;, 
4, &quot;April&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;) &amp; &quot; &quot; &amp; TEXT(YEAR(IF(ISBLANK({!CurrentPLI.Date__c}), TODAY(), ADDMONTHS({!CurrentPLI.Date__c}, 1))))</expression>
    </formulas>
