    <description>3/18 - creation of this flow. It populates the two revenue rollup fields and the Services Rollup field when the invoice date is changed.</description>
    <environments>Default</environments>
    <formulas>
        <name>form_CommaSpace</name>
        <dataType>String</dataType>
        <expression>&quot;, &quot;</expression>
    </formulas>
    <formulas>
        <name>form_RemoveComma</name>
        <dataType>String</dataType>
        <expression>LEFT({!var_NewServicesRollup}, LEN({!var_NewServicesRollup})-2)</expression>
    </formulas>
    <formulas>
        <name>form_RemoveCommaLastServices</name>
        <dataType>String</dataType>
        <expression>LEFT({!var_NewLastServicesRollup}, LEN({!var_NewLastServicesRollup})-2)</expression>
    </formulas>
