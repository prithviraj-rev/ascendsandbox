            <operator>Assign</operator>
            <value>
                <stringValue>0123b000000Utg0AAC</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Case_Record_Type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>assign_Escalated</name>
        <label>Assign Escalated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CaseStage__c</assignToReference>
