        <label>Assign values for Salesforce</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>0123b000000UtfvAAC</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Case_Record_Type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign On Hold variables for the Case record when Status is no longer = &quot;On Hold&quot;</description>
        <name>Remove_On_Hold_Reminder_Values</name>
        <label>Remove On Hold Reminder Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.On_Hold_Reminder__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.On_Hold_Counter__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.On_Hold_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
